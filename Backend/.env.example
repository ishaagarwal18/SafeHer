# ==========================================
# SafeHer Backend Environment Variables
# ==========================================

# 1. Django Core Settings
SECRET_KEY=generate-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=.onrender.com,.vercel.app,localhost,127.0.0.1

# 2. Database Configuration (Optional for Production)
# Leave empty to default to SQLite (db.sqlite3).
# Set this if using PostgreSQL on Render / Supabase / Neon:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# 3. Email Configuration (Gmail SMTP for OTP Verification)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# 4. Twilio SMS Configuration (Emergency Alerts)
# Get credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# 5. External APIs & CORS Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
FRONTEND_URL=https://your-frontend-app.onrender.com

# 6. Journey Safety Settings
SAFETY_CHECK_INTERVAL_MINUTES=10
